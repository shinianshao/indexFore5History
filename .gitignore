# ===========================================================
# 生成产物 —— 全部可由 pipeline/ 重跑，不入库
# 判据：凡 pipeline/*.py 会覆写的文件，一律忽略
# ===========================================================

# 抓取的原始 HTML（fetch_book.py）          约 30MB / 569 文件
data/raw/

# 切分产物（build.py）                      约 50MB / 564 文件
data/corpus/

# 句级编辑前的原始副本（apply_sentence_edits.py 首次编辑时备份）
# 用途：每次重放都从这里出发，撤销一条编辑后重跑即可还原
data/corpus-orig/

# 索引产物（annotate.py / annotate_places.py）约 46MB
data/index/

# 离线静态快照（app/tools/export_static.py）约 15MB / 3 文件
# 它是 dist/ 的意义所在：整个文件夹可以直接发给别人，双击 index.html 就能用。
# 但它是**重跑即再生**的产物，入库只会让仓库白胖 15MB。
dist/

# 本机 %TEMP% 间歇不可用时，Python 的 sqlite 临时文件会掉在 CWD（仓库根目录）。
# 特征：4 字节、内容恰为 `blat`、文件名是 7–8 位 [0-9a-z_]，一次能堆 1200+ 个，
# 把 `git status` 淹掉。
#
# ⚠️ 这里**故意不加文件名规则**（试过 `/xxx`、`/*/xxx`、`!` 反豁免，全都会误伤子目录：
#   git 对「只有开头一个斜杠」的模式仍拿 basename 匹配所有层级，而 `!` 救不了
#   已被排除的目录——`pipeline/_scratch` 这类 7–8 字符的目录名会被规则命中，
#   导致新写的脚本在 status 里凭空消失）。gitignore 只能看文件名、看不见内容，
#   任何名字规则都有误伤风险。
# 真正的防线是 pipeline/_clean_root_blat.py：**按内容 `blat` + git 跟踪状态双重判据**
# 精确删除（默认预演、留名单、git 跟踪的一律不碰）。%TEMP% 故障是间歇性的，
# 跑一次脚本即可，不必为它承担误伤风险。
#
# 清出来的东西**不删、而是 mv 到这里隔离**（2026-10-04）：本机 Python 的
# `os.remove` 与 bash 的 `rm` 都会被挡（WinError 5 / safe-delete 护栏），
# 只有 `mv` 走得通。隔离目录可逆，确认无用后再整体清掉。
# ⚠️ 这是**目录名**规则不是字符类规则，不会误伤 `pipeline/_scratch` 那类名字。
.tmp_probe/

# 词典产物：唯一来源是 build_dict.py 的 PERSONS / CHAPTER_OWNERS
# 与 build_places.py 的 PLACES —— Python 源码已入库，产物不必入库
data/dict/people.json
data/dict/places.json

# 前端数据（annotate*.py 生成，app-data.js 约 32MB / corpus-data.js 约 15MB）
web/app-data.js
web/corpus-data.js
web/pei-data.js
web/js-note-data.js

# ===========================================================
# 探针 / 审计 / 对账报告（可再生）
# ** 使其同时覆盖 pipeline/ 与 pipeline/_scratch/
# ===========================================================
pipeline/**/_*.json
pipeline/**/_*.txt
pipeline/**/_*.log

# ===========================================================
# 备份与运行时
# ===========================================================
*.bak
__pycache__/
*.py[cod]
.mimocode/node_modules/

# ===========================================================
# Excel 权威源目录（workbook/）
#   persons.xlsx / places.xlsx = **人写的权威源**，build_dict.py 优先读它们 → 必须入库
#   sentences-*.xlsx = 脚本可再生的派生视图 → 不入库
#   .bak-<时间戳>.xlsx / *.new.xlsx = 覆盖前备份与人改保护产物 → 不入库
# ===========================================================
workbook/sentences-*.xlsx
workbook/*.bak-*.xlsx
workbook/*.new.xlsx

# ===========================================================
# 注意：以下为「人工资产，不可再生，必须入库」
#   data/dict/books.json          书注册表（手写）
#   data/dict/volumes/*.json      五书篇名表（130×N 条人工审定，工作量最大）
#   data/dict/alias-rules.json    别名规则（手写）
#   pipeline/persons_data.py      PERSONS 种子数据（表格缺失时的回退源）
#   workbook/persons.xlsx         **PERSONS 的权威源**（人写，2026-09-28 起）
#   workbook/overrides.xlsx       单条纠错的权威源（人写，P3）
#   workbook/sentence-edits.xlsx  句级编辑的权威源（人写，P4）
#   pipeline/build_dict.py        规则部分：GENERIC_* / BOOK_CANDIDATES / OFFICE_WORDS
#   pipeline/build_places.py      PLACES 唯一来源
#
# ⚠️ 2026-09-28 更正：PERSONS 的权威源不再是 build_dict.py 本身，
#    而是 workbook/persons.xlsx（缺文件时才回退 persons_data.py）。
# ===========================================================

# 发布包与临时草稿
release/
scratch/
pipeline/_scratch/

